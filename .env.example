# Copy to .env (next to docker-compose.yml) and fill in.

# Anthropic API key for attribute classification. Leave empty to run
# embeddings-only (classification queues as 'pending' until a key is added).
ANTHROPIC_API_KEY=

# Host port the web app is served on: http://<mini-pc-ip>:8420
PORT=8420

# SKU extraction: capture group 1 applied to the filename stem (re.search).
# This pattern matches the shop's real convention — the P.O. number anywhere
# in the name, with or without '#':
#   "Copy of P.O. #140892 - Josh Burtenshaw.jpg" -> 140892
#   "Copy of P.O. 147591 - Skyler Townsend.jpg"  -> 147591
# Files without a P.O. number go to failed/ — or drop them in a ring FOLDER
# named after the SKU, which overrides filename parsing entirely.
SKU_REGEX=P\.?O\.?\s*#?\s*(\d+)

# How often the worker scans data/inbox (seconds).
INBOX_POLL_SECONDS=15

# Set false to skip classification entirely (search still works).
CLASSIFY_ENABLED=true

# CLIP model. Default ViT-L-14 gives the best photo->CAD match quality but needs
# ~3-4GB RAM (allocate to Docker Desktop). For a low-RAM box, use the smaller model:
#   CLIP_MODEL=ViT-B-32
#   CLIP_PRETRAINED=laion2b_s34b_b79k
