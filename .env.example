# Copy to .env (next to docker-compose.yml) and fill in.

# Anthropic API key for attribute classification. Leave empty to run
# embeddings-only (classification queues as 'pending' until a key is added).
ANTHROPIC_API_KEY=

# Host port the web app is served on: http://<mini-pc-ip>:8420
PORT=8420

# SKU extraction: capture group 1 applied to the filename stem.
# Default matches a leading run of letters/digits/dashes, e.g.
#   SW-2841_views.jpg -> SW-2841
# CONFIRM THIS AGAINST YOUR REAL FILENAMES before bulk ingestion.
SKU_REGEX=^([A-Za-z0-9-]+)

# How often the worker scans data/inbox (seconds).
INBOX_POLL_SECONDS=15

# Set false to skip classification entirely (search still works).
CLASSIFY_ENABLED=true
